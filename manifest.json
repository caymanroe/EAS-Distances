{
  "manifest_version": 3,
  "name": "EAS Distances",
  "version": "1.0.0",
  "description": "Right-click a coordinate (e.g. 53°10'39.38''N, 6°31'35.21''W) to get distances, headings, times and fuel burn to hospitals around Ireland.",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eas-distances@eas.local",
      "strict_min_version": "115.0"
    }
  }
}
